rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write ONLY their own ledger document,
    // stored at /ledgers/{their uid}. Nobody can read anyone else's data.
    match /ledgers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
